# macOS
.DS_Store

# Obsidian per-vault app config (created when you open this folder as a vault)
.obsidian/

# Node
node_modules/
.quartz-local/
.quartz-local.npm-cache/

# Python
__pycache__/
.venv/

# Proxy credentials for fetch_youtube.py (never commit) + scrape staging
scripts/.proxies*
collection/json/.youtube-staging.json
raw/.publications-staging.json
raw/.mailchimp-staging.json

# Local cache of non-public (private/unlisted) video ids fetch_youtube_api.py
# has already excluded — this repo is PUBLIC, so this must never be
# committed: even the existence/id of a private video shouldn't leak here.
collection/nonpublic.json

.env

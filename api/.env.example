# Port the API listens on
PORT=4000

# Path to the archive-wiki checkout this API serves.
# Defaults to the parent of this api/ package (i.e. the wiki repo root).
#ARCHIVE_PATH=/path/to/archive-wiki

# Shared bearer token. When set, all routes except /v1/health require
# `Authorization: Bearer <token>`. Leave unset for open local development.
#ARCHIVE_API_TOKEN=

{
  "name": "archive-wiki-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API over the BKC Archive Wiki: lexical search, wiki pages, and archive items. See llm_engine docs/pages/developers/archive_wiki_api.md for the PRD.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "mcp:stdio:dev": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "minisearch": "^7.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
